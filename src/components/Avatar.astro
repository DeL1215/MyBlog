---
import { siteConfig } from '../config/site';
import { withBase } from '../utils/paths';

interface Props {
  size?: 'small' | 'large';
}

const { size = 'large' } = Astro.props;
---

<div class:list={['avatar', `avatar--${size}`, { 'avatar--empty': !siteConfig.avatar }]}>
  {siteConfig.avatar ? (
    <img src={withBase(siteConfig.avatar)} alt={siteConfig.avatarAlt} />
  ) : (
    <span aria-label="大頭照預留位置">{siteConfig.nickname.slice(0, 1)}</span>
  )}
</div>

<style>
  .avatar { position: relative; isolation: isolate; flex: none; display: grid; place-items: center; overflow: hidden; aspect-ratio: 1; border-radius: 50%; background: var(--chalk); box-shadow: 0 22px 54px rgb(32 40 48 / .2); }
  .avatar::before { position: absolute; z-index: -1; inset: 8%; content: ''; border: 1px solid rgb(242 239 230 / .58); border-radius: inherit; }
  .avatar--large { width: clamp(190px, 21vw, 310px); }
  .avatar--small { width: 64px; }
  .avatar--empty { color: var(--chalk); background: var(--ink); }
  .avatar--empty::after { position: absolute; z-index: -2; right: -18%; bottom: -10%; width: 72%; aspect-ratio: 1; content: ''; background: var(--rust); transform: rotate(18deg); }
  .avatar span { font: 700 clamp(4.5rem, 9vw, 8rem)/1 var(--font-editorial); transform: translateY(-.04em); }
  .avatar--small span { font-size: 1.7rem; }
  img { width: 100%; height: 100%; object-fit: cover; }
</style>
