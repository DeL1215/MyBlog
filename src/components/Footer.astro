---
import { withBase } from '../utils/paths';
import { siteConfig } from '../config/site';
---

<footer class="site-footer" id="contact">
  <div class="footer-inner">
    <div class="footer-mark" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="footer-main">
      <a class="footer-name" href={withBase('/')}>{siteConfig.blogTitle}</a>
      <a class="footer-email" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
    </div>
    <nav aria-label="頁尾導覽">
      <a href={withBase('/achievements/')}>成果</a>
      <a href={withBase('/blog/')}>文章</a>
      <a href={withBase('/about/')}>關於</a>
    </nav>
    <p class="footer-meta">© {new Date().getFullYear()} {siteConfig.nickname}</p>
  </div>
</footer>

<style>
  .site-footer { color: var(--chalk); background: var(--ink); }
  .footer-inner { width: min(calc(100% - 72px), var(--page-width)); min-height: 290px; margin: 0 auto; padding-block: 52px 26px; display: grid; grid-template-columns: 150px 1fr auto; grid-template-rows: 1fr auto; gap: 36px; }
  .footer-mark { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; gap: 6px; aspect-ratio: 1; }
  .footer-mark i { background: var(--rust); }
  .footer-mark i:nth-child(2) { background: var(--steel); clip-path: polygon(0 0, 100% 0, 100% 100%, 42% 100%); }
  .footer-mark i:nth-child(3) { grid-column: 1 / -1; background: var(--chalk); clip-path: polygon(0 0, 66% 0, 66% 50%, 100% 50%, 100% 100%, 0 100%); }
  .footer-main { align-self: center; display: grid; gap: 18px; }
  .footer-name { width: fit-content; color: var(--chalk); font: 700 clamp(2.3rem, 4vw, 4.5rem)/1 var(--font-editorial); letter-spacing: -.035em; text-decoration: none; }
  .footer-email { width: fit-content; color: rgb(242 239 230 / .76); font-size: .9rem; }
  nav { align-self: center; display: grid; grid-template-columns: repeat(3, auto); gap: 34px; }
  nav a { min-height: 44px; display: grid; place-items: center; color: var(--chalk); font-size: .9rem; text-decoration: none; }
  nav a:hover { color: var(--steel-light); }
  .footer-meta { grid-column: 1 / -1; margin: 0; padding-top: 18px; border-top: 1px solid var(--rule-on-dark); color: rgb(242 239 230 / .58); font-size: .72rem; }

  @media (max-width: 760px) {
    .footer-inner { width: min(calc(100% - 32px), var(--page-width)); grid-template-columns: 80px 1fr; grid-template-rows: auto; }
    .footer-main { align-self: start; }
    nav { grid-column: 1 / -1; justify-content: start; }
    .footer-meta { grid-column: 1 / -1; }
  }
</style>
