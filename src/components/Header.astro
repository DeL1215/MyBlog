---
import { withBase } from '../utils/paths';
import { siteConfig } from '../config/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: '首頁' },
  { href: '/about/', label: '關於我' },
  { href: '/achievements/', label: '成果' },
  { href: '/blog/', label: '文章' },
].map((link) => ({ ...link, url: withBase(link.href) }));
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={withBase('/')} aria-label={`${siteConfig.blogTitle} 首頁`}><span>{siteConfig.blogTitle}</span></a>
    <nav aria-label="主要導覽">
      {links.map((link) => (
        <a href={link.url} aria-current={path === link.url.replace(/\/$/, '') || (link.href !== '/' && path.startsWith(link.url.replace(/\/$/, ''))) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header { position: sticky; z-index: 100; top: 0; color: var(--ink); background: rgb(252 251 248 / .94); border-bottom: 1px solid var(--rule); backdrop-filter: blur(14px); }
  .header-inner { width: min(calc(100% - 72px), var(--page-width)); min-height: 74px; margin-inline: auto; display: grid; grid-template-columns: 1fr auto; align-items: stretch; }
  .brand { width: fit-content; display: flex; align-items: center; color: var(--ink); font: 700 1.38rem/1 var(--font-editorial); letter-spacing: -.025em; text-decoration: none; }
  .brand::before { width: 12px; height: 100%; margin-right: 16px; content: ''; background: var(--rust); clip-path: polygon(0 0, 100% 0, 100% 78%, 0 100%); }
  nav { display: flex; align-items: stretch; gap: clamp(22px, 4vw, 62px); }
  nav a { position: relative; min-width: 44px; display: grid; place-items: center; color: var(--ink); font-size: .92rem; font-weight: 600; text-decoration: none; }
  nav a::after { position: absolute; right: 0; bottom: -1px; left: 0; height: 4px; content: ''; background: var(--rust); transform: scaleX(0); transform-origin: left; transition: transform var(--motion); }
  nav a:hover, nav a[aria-current='page'] { color: var(--rust-dark); }
  nav a:hover::after, nav a[aria-current='page']::after { transform: scaleX(1); }

  @media (max-width: 700px) {
    .header-inner { width: calc(100% - 32px); min-height: 0; grid-template-columns: 1fr; }
    .brand { min-height: 54px; font-size: 1.16rem; }
    .brand::before { width: 8px; margin-right: 10px; }
    nav { min-height: 48px; justify-content: space-between; gap: 8px; border-top: 1px solid var(--rule); }
    nav a { flex: 1; font-size: .9rem; }
  }
</style>
