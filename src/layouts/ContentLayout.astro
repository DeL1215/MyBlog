---
import BaseLayout from './BaseLayout.astro';
import { withBase } from '../utils/paths';
import { siteConfig } from '../config/site';
import EditorialVisual from '../components/EditorialVisual.astro';

interface Props {
  title: string;
  description: string;
  meta: string;
  image?: string;
  imageAlt?: string;
  visualVariant?: 'blog' | 'technical' | 'artistic';
}

const { title, description, meta, image, imageAlt = '', visualVariant = 'blog' } = Astro.props;
---

<BaseLayout title={`${title}｜${siteConfig.blogTitle}`} description={description} image={image}>
  <article class="content-shell" data-visual={visualVariant}>
    <header class="content-header" data-visual={visualVariant}>
      <div class="content-header__copy"><p>{meta}</p><h1>{title}</h1><div class="lead">{description}</div></div>
      <EditorialVisual variant={visualVariant} />
    </header>
    {image && <img class="content-cover" src={withBase(image)} alt={imageAlt} />}
    <div class="prose"><slot /></div>
  </article>
</BaseLayout>

<style>
  .content-shell {
    position: relative;
    padding-bottom: clamp(80px, 10vw, 140px);
    background: radial-gradient(circle at 14% 58%, rgb(23 56 196 / .055), transparent 24%), radial-gradient(circle at 88% 82%, rgb(180 63 39 / .06), transparent 26%);
  }

  .content-header { position: relative; isolation: isolate; overflow: hidden; width: 100%; max-width: none; display: grid; grid-template-columns: minmax(300px, 1fr) minmax(420px, .8fr); gap: clamp(44px, 7vw, 110px); align-items: center; padding: clamp(70px, 8vw, 110px) max(24px, calc((100% - 1420px) / 2)); color: var(--chalk); background: var(--ink); }
  .content-header::after { position: absolute; z-index: -1; right: -8vw; bottom: -24%; width: min(45vw, 620px); aspect-ratio: 1.5; content: ''; background: var(--rust); clip-path: polygon(0 24%, 30% 24%, 30% 0, 72% 0, 72% 40%, 100% 40%, 100% 100%, 40% 100%, 40% 72%, 0 72%); }
  .content-header[data-visual='technical'], .content-header[data-visual='artistic'], .content-header[data-visual='blog'] { grid-template-columns: 1fr; color: var(--ink); }
  .content-header[data-visual='technical'] { background: linear-gradient(118deg, #fcfbf8 0 61%, #e3e8ff 100%); }
  .content-header[data-visual='artistic'] { background: linear-gradient(118deg, #fcfbf8 0 59%, #f5dfd7 100%); }
  .content-header[data-visual='blog'] { background: linear-gradient(118deg, #fcfbf8 0 58%, #e9efff 100%); }
  .content-header[data-visual='technical']::after { display: block; right: 9%; bottom: 14%; width: min(32vw, 440px); background: var(--cobalt); opacity: .16; }
  .content-header[data-visual='artistic']::after { display: block; right: 9%; bottom: 13%; width: min(32vw, 440px); background: var(--rust); opacity: .18; transform: rotate(-10deg); }
  .content-header[data-visual='blog']::after { display: block; right: 9%; bottom: 15%; width: min(30vw, 410px); background: var(--cobalt); opacity: .14; transform: rotate(8deg); }
  .content-header[data-visual='technical'] .content-header__copy, .content-header[data-visual='artistic'] .content-header__copy, .content-header[data-visual='blog'] .content-header__copy { position: relative; z-index: 2; }
  .content-header[data-visual='technical'] p, .content-header[data-visual='artistic'] p, .content-header[data-visual='blog'] p { color: var(--muted); }
  .content-header[data-visual='technical'] .lead, .content-header[data-visual='artistic'] .lead, .content-header[data-visual='blog'] .lead { color: var(--ink-soft); }
  .content-header[data-visual='technical'] .editorial-visual, .content-header[data-visual='artistic'] .editorial-visual, .content-header[data-visual='blog'] .editorial-visual { display: none; }
  .content-header[data-visual='technical'] .editorial-visual, .content-header[data-visual='artistic'] .editorial-visual, .content-header[data-visual='blog'] .editorial-visual { display: none; }
  .content-header p {
    margin: 0 0 32px;
    color: var(--steel-light);
    font: 600 .88rem var(--font-ui);
    letter-spacing: .02em;
  }

  h1 {
    max-width: 920px;
    margin: 0;
    font: 800 clamp(3rem, 7vw, 6rem)/1.08 var(--font-display);
    letter-spacing: -.04em;
  }

  .lead {
    max-width: 740px;
    margin-top: 30px;
    color: rgb(242 239 230 / .78);
    font: 400 clamp(1.08rem, 1.8vw, 1.28rem)/1.85 var(--font-body);
  }

  .content-cover {
    width: min(calc(100% - 48px), 1080px);
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin: 70px auto;
    border: 1px solid var(--rule);
  }

  .prose { width: min(calc(100% - 48px), var(--reading-width)); margin: 70px auto 0; }

  @media (max-width: 980px) { .content-header { grid-template-columns: 1fr; } }

  @media (max-width: 700px) {
    .content-header { grid-template-columns: 1fr; padding-inline: 16px; }
    .content-cover { margin: 44px auto; }
    .content-cover, .prose { width: min(calc(100% - 32px), 760px); }
    .prose { margin-top: 44px; }
  }
</style>
