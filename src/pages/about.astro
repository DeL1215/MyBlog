---
import BaseLayout from '../layouts/BaseLayout.astro';
import Avatar from '../components/Avatar.astro';
import { siteConfig } from '../config/site';
import EditorialVisual from '../components/EditorialVisual.astro';
---

<BaseLayout title={`關於｜${siteConfig.blogTitle}`} description={`${siteConfig.nickname}（${siteConfig.legalName}），畢業於大安高工資訊科，目前就讀於台灣科技大學電子工程系。`}>
  <section class="page-masthead">
    <div class="page-masthead__inner shell"><div><h1 class="page-title">關於</h1><p class="page-masthead__intro">我的學習經歷，以及對技術與藝術的興趣。</p></div><EditorialVisual variant="about" /></div>
  </section>
  <section class="about-page shell">
    <div class="intro">
      <div class="portrait">
        <Avatar />
        <span class="orbit orbit-a" aria-hidden="true"></span>
        <span class="orbit orbit-b" aria-hidden="true"></span>
        <span class="burst" aria-hidden="true"></span>
      </div>
      <div class="intro-copy">
        <h2>{siteConfig.nickname}</h2>
        <p>我是 {siteConfig.nickname}，本名 {siteConfig.legalName}。我喜歡電子與程式，也在意作品的視覺、比例和表達方式。目前就讀於台灣科技大學電子工程系，畢業於大安高工資訊科。</p>
        <p class="purpose">我希望自己不只把東西做出來，也能理解它如何運作、為什麼以這樣的方式呈現。這裡記錄我的作品，以及一路上的思考與修正。</p>
      </div>
    </div>
    <div class="details">
      <h2>學習經歷</h2>
      <dl>
        <div><dt>目前</dt><dd>國立台灣科技大學<br />電子工程系</dd></div>
        <div><dt>畢業</dt><dd>臺北市立大安高級工業職業學校<br />資訊科</dd></div>
        <div><dt>聯絡</dt><dd><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></dd></div>
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  .about-page { position: relative; padding-block: clamp(80px, 10vw, 140px) clamp(110px, 14vw, 190px); }
  .about-page::before { position: absolute; z-index: -1; inset: 6% 42% 42% -12%; content: ''; background: radial-gradient(circle, rgb(23 56 196 / .08), transparent 70%); }
  .intro { display: grid; grid-template-columns: minmax(340px, .9fr) minmax(0, 1.1fr); gap: clamp(64px, 10vw, 150px); align-items: center; padding-bottom: clamp(90px, 12vw, 160px); }
  .portrait { position: relative; min-height: 480px; display: grid; place-items: center; }
  .orbit { position: absolute; z-index: -1; border: 1px solid rgb(23 24 29 / .35); border-radius: 50%; }
  .orbit-a { width: 90%; aspect-ratio: 1.65; transform: rotate(-18deg); }
  .orbit-b { width: 72%; aspect-ratio: 1.2; border-color: var(--cobalt); transform: rotate(23deg); }
  .burst { position: absolute; z-index: -1; right: 2%; top: 4%; width: 120px; aspect-ratio: 1; background: var(--cobalt); clip-path: polygon(50% 0, 59% 38%, 82% 8%, 70% 43%, 100% 33%, 73% 51%, 100% 69%, 65% 61%, 70% 100%, 53% 65%, 39% 100%, 40% 62%, 7% 82%, 33% 53%, 0 46%, 38% 45%); }
  .intro-copy h2 { margin: 0 0 28px; color: var(--cobalt-dark); font: 700 clamp(3rem, 6vw, 6rem)/1 var(--font-editorial); letter-spacing: -.045em; }
  .intro-copy > p { max-width: 760px; margin: 0; font-size: clamp(1.12rem, 2vw, 1.45rem); line-height: 1.85; }
  .purpose { margin-top: 24px !important; color: var(--muted); }
  .details { display: grid; grid-template-columns: .75fr 1.25fr; gap: clamp(40px, 8vw, 130px); border-top: 2px solid var(--ink); padding-top: 40px; }
  .details h2 { margin: 0; color: var(--cobalt-dark); font: 700 clamp(1.7rem, 3vw, 2.4rem) var(--font-editorial); }
  dl { margin: 0; }
  dl div { display: grid; grid-template-columns: 100px 1fr; border-top: 1px solid var(--rule-light); padding: 22px 0; }
  dl div:first-child { border-top: 0; }
  dt { color: var(--cobalt-dark); font: 700 .9rem var(--font-ui); }
  dd { margin: 0; line-height: 1.8; }
  dd a { color: var(--cobalt-dark); text-underline-offset: .25em; }
  @media (max-width: 700px) {
    .intro, .details { grid-template-columns: 1fr; }
    .portrait { min-height: 360px; }
    .intro-copy { margin-top: 10px; }
    .burst { width: 82px; }
  }
</style>
