---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArrowIcon from '../../components/ArrowIcon.astro';
import { achievementCategoryLabel, achievementDomains, achievementTypeLabel, achievementTypes } from '../../data/achievements';
import { withBase } from '../../utils/paths';
import { siteConfig } from '../../config/site';
import EditorialVisual from '../../components/EditorialVisual.astro';

const achievements = (await getCollection('achievements', ({ data }) => !data.draft)).sort((a, b) => b.data.year - a.data.year);
---

<BaseLayout title={`成果｜${siteConfig.blogTitle}`} description={`${siteConfig.nickname}的技術作品、藝術創作、競賽與學習紀錄。`}>
  <section class="page-masthead">
    <div class="page-masthead__inner shell"><div><h1 class="page-title">成果</h1><p class="page-masthead__intro">這裡整理我的技術作品、藝術創作、競賽與其他學習紀錄。</p></div><EditorialVisual variant="achievements" /></div>
  </section>
  <section class="archive shell">
      <div class="filter-panel" aria-label="成果篩選">
        <div class="filter-set"><span class="filter-label">領域</span><div class="filters" role="group" aria-label="依領域篩選成果">{achievementDomains.map((domain) => <button type="button" data-domain-filter={domain.key} aria-pressed="false">{domain.label}</button>)}</div></div>
        <div class="filter-set"><span class="filter-label">形式</span><div class="filters" role="group" aria-label="依形式篩選成果">{achievementTypes.map((type) => <button type="button" data-type-filter={type.key} aria-pressed="false">{type.label}</button>)}</div></div>
      </div>
    <p class="filter-status" aria-live="polite"></p>
    <div class="register" aria-live="polite">
      {achievements.map((item) => (
        <article class="row" data-category={item.data.category} data-type={item.data.type}>
          <div class="meta"><span>{achievementCategoryLabel[item.data.category]}</span><span class="type">{achievementTypeLabel[item.data.type]}</span><span>{item.data.year}</span></div>
          <div class="body">
            {item.data.sample && <span class="sample">內容範例</span>}
            <h2><a href={withBase(`/achievements/${item.id}/`)}>{item.data.title}</a></h2>
            <p>{item.data.description}</p>
            {item.data.technologies.length > 0 && <ul>{item.data.technologies.map((technology) => <li>{technology}</li>)}</ul>}
          </div>
          {item.data.cover ? <a class="cover" href={withBase(`/achievements/${item.id}/`)}><img src={withBase(item.data.cover)} alt={item.data.coverAlt ?? ''} /></a> : <div class="blank" aria-label="此成果尚未加入封面圖片"><span>尚無封面</span></div>}
          <a class="open" href={withBase(`/achievements/${item.id}/`)} aria-label={`查看成果：${item.data.title}`}><ArrowIcon /></a>
        </article>
      ))}
      {achievements.length === 0 && <p class="empty">目前尚未公開成果。</p>}
      {achievements.length > 0 && <p class="no-results" hidden>目前沒有符合這組條件的成果。可以調整領域或形式。</p>}
    </div>
  </section>
</BaseLayout>

<script>
  const domainButtons = document.querySelectorAll<HTMLButtonElement>('[data-domain-filter]');
  const typeButtons = document.querySelectorAll<HTMLButtonElement>('[data-type-filter]');
  const rows = document.querySelectorAll<HTMLElement>('[data-category]');
  const params = new URLSearchParams(location.search);
  const validDomains = ['technical', 'artistic'];
  const validTypes = ['project', 'competition', 'certificate', 'experience', 'other'];
  const requestedDomain = params.get('domain') ?? params.get('category') ?? 'all';
  const requestedType = params.get('type') ?? 'all';
  let currentDomain = validDomains.includes(requestedDomain) ? requestedDomain : 'all';
  let currentType = validTypes.includes(requestedType) ? requestedType : 'all';
  const status = document.querySelector<HTMLElement>('.filter-status');
  const noResults = document.querySelector<HTMLElement>('.no-results');
  const applyFilters = () => {
    domainButtons.forEach((button) => {
      const active = button.dataset.domainFilter === currentDomain;
      button.classList.toggle('active', active);
      button.setAttribute('aria-pressed', String(active));
    });
    typeButtons.forEach((button) => {
      const active = button.dataset.typeFilter === currentType;
      button.classList.toggle('active', active);
      button.setAttribute('aria-pressed', String(active));
    });
    rows.forEach((row) => {
      const domainMatches = currentDomain === 'all' || row.dataset.category === currentDomain;
      const typeMatches = currentType === 'all' || row.dataset.type === currentType;
      row.hidden = !domainMatches || !typeMatches;
    });
    const visibleCount = [...rows].filter((row) => !row.hidden).length;
    const domainName = [...domainButtons].find((button) => button.dataset.domainFilter === currentDomain)?.textContent?.trim() ?? '全部';
    const typeName = [...typeButtons].find((button) => button.dataset.typeFilter === currentType)?.textContent?.trim() ?? '全部';
    if (status) status.textContent = `${domainName}／${typeName}，共 ${visibleCount} 筆成果`;
    if (noResults) noResults.hidden = visibleCount !== 0;
    const nextUrl = new URL(location.href);
    currentDomain === 'all' ? nextUrl.searchParams.delete('domain') : nextUrl.searchParams.set('domain', currentDomain);
    currentType === 'all' ? nextUrl.searchParams.delete('type') : nextUrl.searchParams.set('type', currentType);
    nextUrl.searchParams.delete('category');
    history.replaceState({}, '', nextUrl);
  };
  domainButtons.forEach((button) => button.addEventListener('click', () => { currentDomain = button.dataset.domainFilter ?? 'all'; applyFilters(); }));
  typeButtons.forEach((button) => button.addEventListener('click', () => { currentType = button.dataset.typeFilter ?? 'all'; applyFilters(); }));
  applyFilters();
</script>

<style>
  .archive { padding-block: clamp(64px, 8vw, 110px); }
  .filters { display: flex; flex-wrap: wrap; gap: 4px; }
  .filter-panel { display: grid; grid-template-columns: auto 1fr; gap: 18px 72px; margin-bottom: 64px; padding: 24px 28px; background: linear-gradient(100deg, rgb(23 56 196 / .08), rgb(255 255 255 / .55) 48%, rgb(180 63 39 / .08)); border-top: 2px solid var(--ink); border-bottom: 1px solid var(--rule); }
  .filter-set { display: grid; grid-template-columns: 48px 1fr; align-items: center; gap: 18px; }
  .filter-label { color: var(--muted); font: 700 .78rem var(--font-ui); letter-spacing: .04em; }
  button { min-height: 44px; border: 1px solid transparent; padding: 8px 13px; color: var(--ink); background: transparent; font: 600 .9rem var(--font-body); cursor: pointer; transition: color var(--motion), background var(--motion), border-color var(--motion), transform var(--motion); }
  button:hover { border-color: var(--ink); background: rgb(242 239 230 / .45); }
  button:active { transform: translateY(1px); }
  button.active { color: var(--chalk); background: var(--rust); border-color: var(--rust); }
  button[data-domain-filter='technical'].active { background: var(--cobalt); border-color: var(--cobalt); }
  button[data-domain-filter='artistic'].active { background: var(--rust); border-color: var(--rust); }
  .register { border-top: 2px solid var(--ink); }
  .filter-status { height: 1px; margin: 0; overflow: hidden; clip-path: inset(50%); }
  .row { display: grid; grid-template-columns: 128px minmax(300px, 1fr) minmax(210px, 28%) 28px; gap: clamp(20px, 4vw, 56px); align-items: stretch; min-height: 230px; border-bottom: 1px solid var(--rule); padding: 38px 16px; transition: background var(--motion); }
  .row:hover { background: rgb(113 139 152 / .13); }
  .row[hidden] { display: none; }
  .row[data-category='technical'] { --category-color: var(--blue); }
  .row[data-category='artistic'] { --category-color: var(--rust-dark); }
  .meta { display: grid; align-content: space-between; color: var(--category-color, var(--rust-dark)); font: 700 1rem/1.5 var(--font-ui); letter-spacing: .02em; }
  .meta .type { color: var(--muted); }
  .body { align-self: center; }
  .sample { color: var(--muted); font: 600 .78rem var(--font-ui); letter-spacing: .02em; }
  h2 { margin: 10px 0 12px; font: 800 clamp(1.9rem, 3vw, 3.25rem)/1.2 var(--font-display); letter-spacing: -.035em; }
  h2 a { color: var(--ink); text-decoration: none; }
  h2 a:hover { color: var(--rust-dark); }
  .body p { max-width: 620px; margin: 0; color: var(--muted); }
  ul { display: flex; flex-wrap: wrap; gap: 8px 18px; list-style: none; margin: 18px 0 0; padding: 0; color: var(--muted); font: 600 .78rem var(--font-ui); }
  .cover, .blank { min-height: 160px; }
  .cover img { width: 100%; height: 100%; border: 1px solid var(--rule); object-fit: cover; }
  .blank { position: relative; display: grid; place-items: center; overflow: hidden; color: var(--chalk); background: var(--ink); font: 600 .76rem var(--font-ui); letter-spacing: .03em; }
  .blank::before { position: absolute; inset: 15% -8% auto 28%; height: 42%; content: ''; border: 2px solid var(--category-color); border-radius: 50%; transform: rotate(-12deg); }
  .blank::after { position: absolute; right: -6%; bottom: -18%; width: 58%; aspect-ratio: 1; content: ''; background: var(--category-color); clip-path: polygon(0 35%, 35% 35%, 35% 0, 70% 0, 70% 42%, 100% 42%, 100% 100%, 22% 100%, 22% 72%, 0 72%); }
  .blank span { position: relative; z-index: 2; }
  .open { align-self: center; color: var(--rust-dark); text-decoration: none; transition: transform var(--motion); }
  .open:hover { transform: translate(3px, -3px); }
  .empty, .no-results { margin: 0; padding: 32px 0; border-bottom: 1px solid var(--rule); color: var(--muted); }
  @media (max-width: 900px) { .filter-panel { grid-template-columns: 1fr; gap: 10px; } .row { grid-template-columns: 88px 1fr 28px; min-height: 0; } .cover, .blank { grid-column: 2 / -1; min-height: 180px; } .open { grid-column: 3; grid-row: 1; } }
  @media (max-width: 520px) { .filter-panel { padding: 18px 16px; } .filter-set { grid-template-columns: 1fr; gap: 4px; } .row { gap: 16px; } .meta { font-size: .94rem; } }
</style>
