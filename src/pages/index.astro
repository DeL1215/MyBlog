---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TextLink from '../components/TextLink.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import Avatar from '../components/Avatar.astro';
import FeaturedShowcase from '../components/FeaturedShowcase.astro';
import { achievementCategoryLabel, achievementTypeLabel } from '../data/achievements';
import { siteConfig } from '../config/site';
import { withBase } from '../utils/paths';

const achievements = (await getCollection('achievements', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => b.data.year - a.data.year).slice(0, 4);
const showcaseItems = achievements.map((item) => ({
  href: `/achievements/${item.id}/`,
  title: item.data.title,
  description: item.data.description,
  category: item.data.category,
  categoryLabel: achievementCategoryLabel[item.data.category],
  typeLabel: achievementTypeLabel[item.data.type],
  cover: item.data.cover,
  coverAlt: item.data.coverAlt,
}));
const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()).slice(0, 3);
const formatDate = (date: Date) => new Intl.DateTimeFormat('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit' }).format(date);
---

<BaseLayout title={siteConfig.blogTitle} description={`${siteConfig.nickname}的個人部落格，收錄技術與藝術作品、學習經歷和個人思考。`} image="/images/hero-editorial-collage-v5.webp">
  <section class="hero" aria-labelledby="hero-title">
    <img
      class="hero-artwork"
      src={withBase('/images/hero-editorial-collage-v5.webp')}
      alt=""
      width="1536"
      height="1024"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-inner shell">
      <div class="hero-copy">
        <h1 id="hero-title">{siteConfig.blogTitle}</h1>
        <p class="hero-statement">這是一個簡單的小部落格。</p>
        <p class="hero-description">收錄我的作品和思考，也希望透過這些內容，讓你更認識我。</p>
        <div class="hero-actions">
          <TextLink href="/blog/" tone="light">閱讀文章</TextLink>
          <a class="outline-action" href={withBase('/achievements/')}>瀏覽成果 <ArrowIcon size={19} /></a>
        </div>
      </div>
    </div>
    <FeaturedShowcase items={showcaseItems} />
  </section>

  <nav class="section-index" aria-label="首頁內容索引">
    <div class="shell">
      <a href="#about-intro"><strong>關於我</strong><span>能力、經歷與興趣</span><ArrowIcon /></a>
      <a href="#achievements"><strong>成果</strong><span>技術、競賽與創作</span><ArrowIcon /></a>
      <a href="#articles"><strong>文章</strong><span>製作紀錄與想法</span><ArrowIcon /></a>
    </div>
  </nav>

  <section id="about-intro" class="visual-language shell" aria-labelledby="about-intro-title">
    <img class="visual-artwork" src={withBase('/images/editorial-botanical-collage-v1.webp')} alt="" width="1536" height="1024" loading="lazy" decoding="async" aria-hidden="true" />
    <div class="visual-avatar"><Avatar size="medium" /></div>
    <div class="visual-copy">
      <span class="signal-mark" aria-hidden="true"></span>
      <h2 id="about-intro-title">關於我</h2>
      <p>我是勞什，專注於嵌入式系統開發與 AI 應用，也持續進行藝術創作。這裡整理我的作品、經歷與思考。</p>
      <TextLink href="/about/">查看完整介紹</TextLink>
    </div>
  </section>

  <section id="achievements" class="achievements-section shell" aria-labelledby="achievements-title">
    <header>
      <h2 id="achievements-title">成果</h2>
      <p>整理我做過的技術與藝術作品，以及競賽和學習紀錄。</p>
      <TextLink href="/achievements/">全部成果</TextLink>
    </header>
    <div class="register">
      {achievements.map((item) => (
        <a class="register-row" data-category={item.data.category} href={withBase(`/achievements/${item.id}/`)}>
          <span class="kind">{achievementCategoryLabel[item.data.category]}<small>{achievementTypeLabel[item.data.type]}</small></span>
          <div><h3>{item.data.title}</h3><p>{item.data.description}</p></div>
          <span class="year">{item.data.year}</span>
          <span class="row-arrow" aria-hidden="true"><ArrowIcon /></span>
        </a>
      ))}
      {achievements.length === 0 && <p class="empty-state">目前尚未公開成果。</p>}
    </div>
    <div class="pixel-field" aria-hidden="true">{Array.from({ length: 18 }).map(() => <i></i>)}</div>
  </section>

  <section id="articles" class="articles-section" aria-labelledby="articles-title">
    <div class="articles-inner shell">
      <header>
        <h2 id="articles-title">文章</h2>
        <p>記錄作品的製作過程、遇到的問題，以及偶爾想留下來的事。</p>
        <TextLink href="/blog/">全部文章</TextLink>
      </header>
      <div class="article-list">
        {posts.map((post) => (
          <a href={withBase(`/blog/${post.id}/`)}>
            <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <span aria-hidden="true"><ArrowIcon /></span>
          </a>
        ))}
        {posts.length === 0 && <p class="empty-state">目前尚未公開文章。</p>}
      </div>
      <div class="orbit" aria-hidden="true"><i></i><i></i><i></i></div>
    </div>
  </section>

</BaseLayout>

<style>
  .hero { position: relative; isolation: isolate; min-height: calc(100dvh - 74px); overflow: hidden; background: #f3f0e8; }
  .visual-language, .achievements-section, .articles-section { scroll-margin-top: 96px; }
  .hero-artwork { position: absolute; z-index: -1; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .hero-inner { min-height: calc(100dvh - 74px); display: flex; align-items: center; padding-block: 64px; }
  .hero-copy { width: min(42%, 650px); }
  h1 { max-width: 8ch; margin: 0; font: 700 clamp(4rem, 7vw, 7.6rem)/.88 var(--font-editorial); letter-spacing: -.045em; }
  .hero-statement { margin: 34px 0 0; color: var(--cobalt); font: 800 clamp(1.35rem, 2vw, 2rem)/1.35 var(--font-display); }
  .hero-description { max-width: 29ch; margin: 16px 0 0; color: var(--ink-soft); font-size: clamp(1.05rem, 1.35vw, 1.22rem); line-height: 1.8; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 32px; }
  .outline-action { min-width: 156px; min-height: 48px; display: inline-flex; align-items: center; justify-content: center; gap: 18px; padding: 10px 20px; color: var(--cobalt-dark); border: 2px solid var(--cobalt); background: rgb(243 240 232 / .64); font-weight: 700; text-decoration: none; transition: color var(--motion), background var(--motion), transform var(--motion); }
  .outline-action:hover { color: var(--chalk); background: var(--cobalt); }
  .outline-action:active { transform: translateY(1px); }

  .section-index { color: var(--chalk); background: var(--ink); }
  .section-index > div { display: grid; grid-template-columns: repeat(3, 1fr); }
  .section-index a { min-height: 126px; display: grid; grid-template-columns: auto 1fr 28px; gap: 22px; align-items: center; padding: 28px 30px; color: var(--chalk); border-left: 1px solid var(--rule-on-dark); text-decoration: none; }
  .section-index a:last-child { border-right: 1px solid var(--rule-on-dark); }
  .section-index strong { font: 700 1.35rem var(--font-editorial); }
  .section-index span { color: rgb(242 239 230 / .72); font-size: .94rem; }
  .section-index :global(svg) { transition: transform var(--motion); }
  .section-index a:hover { color: var(--cobalt-soft); }
  .section-index a:hover :global(svg) { transform: translate(4px, -4px); }

  .visual-language { position: relative; isolation: isolate; min-height: 720px; display: grid; grid-template-columns: 1fr minmax(360px, .72fr); align-items: center; overflow: hidden; margin-block: clamp(80px, 10vw, 150px); border-block: 1px solid var(--rule); background: var(--chalk); }
  .visual-artwork { position: absolute; z-index: -1; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .visual-avatar { position: absolute; z-index: 1; left: 24%; top: 50%; width: clamp(180px, 18vw, 244px); padding: 10px; border: 1px solid rgb(23 24 29 / .24); border-radius: 50%; background: rgb(252 251 248 / .9); box-shadow: 0 24px 65px rgb(23 24 29 / .2); transform: translate(-50%, -50%); }
  .visual-avatar :global(.avatar) { width: 100%; }
  .visual-copy { position: relative; z-index: 2; grid-column: 2; margin: clamp(42px, 6vw, 90px); padding: clamp(34px, 4vw, 62px); background: rgb(252 251 248 / .9); box-shadow: 0 28px 70px rgb(23 24 29 / .16); }
  .visual-copy h2 { margin: 0; font: 700 clamp(3rem, 5vw, 6rem)/.95 var(--font-editorial); letter-spacing: -.04em; }
  .visual-copy p { margin: 28px 0 26px; line-height: 1.9; }
  .signal-mark { position: absolute; z-index: -1; right: -12%; top: -68px; width: 120px; aspect-ratio: 1; background: var(--cobalt); clip-path: polygon(50% 0, 59% 38%, 82% 8%, 70% 43%, 100% 33%, 73% 51%, 100% 69%, 65% 61%, 70% 100%, 53% 65%, 39% 100%, 40% 62%, 7% 82%, 33% 53%, 0 46%, 38% 45%); }

  .achievements-section { position: relative; display: grid; grid-template-columns: minmax(240px, .45fr) minmax(0, 1.25fr); gap: clamp(50px, 9vw, 140px); padding-block: clamp(100px, 12vw, 170px); }
  .achievements-section header { position: sticky; top: 110px; align-self: start; }
  .achievements-section h2, .articles-section h2 { margin: 0; font: 700 clamp(3.5rem, 7vw, 7rem)/1 var(--font-editorial); letter-spacing: -.045em; }
  .achievements-section header p, .articles-section header p { max-width: 27ch; margin: 24px 0 22px; color: var(--muted); }
  .register { position: relative; z-index: 2; border-top: 2px solid var(--ink); }
  .register-row { display: grid; grid-template-columns: 110px 1fr 64px 26px; gap: 24px; align-items: start; min-height: 150px; padding: 28px 10px 28px 0; color: var(--ink); border-bottom: 1px solid var(--rule); text-decoration: none; transition: background var(--motion); }
  .register-row:hover { background: rgb(21 52 199 / .08); }
  .register-row > div { transition: transform var(--motion); }
  .register-row:hover > div { transform: translateX(8px); }
  .kind, .year { color: var(--category-color, var(--cobalt-dark)); font-size: 1rem; line-height: 1.5; font-weight: 700; letter-spacing: .02em; }
  .kind small { display: block; margin-top: 7px; color: var(--muted); font: inherit; font-size: .94rem; font-weight: 500; }
  .register-row[data-category='technical'] { --category-color: var(--cobalt-dark); }
  .register-row[data-category='artistic'] { --category-color: var(--rust-dark); }
  .register-row h3, .article-list h3 { margin: 0; font: 700 clamp(1.42rem, 2.1vw, 2.1rem)/1.35 var(--font-display); letter-spacing: -.025em; }
  .register-row p { max-width: 620px; margin: 8px 0 0; color: var(--muted); font-size: .96rem; }
  .row-arrow { color: var(--cobalt-dark); transition: transform var(--motion); }
  .register-row:hover .row-arrow { transform: translate(4px, -4px); }
  .pixel-field { position: absolute; right: -10px; bottom: 40px; width: 126px; display: grid; grid-template-columns: repeat(6, 1fr); gap: 4px; opacity: .9; }
  .pixel-field i { aspect-ratio: 1; background: var(--cobalt); }
  .pixel-field i:nth-child(3n), .pixel-field i:nth-child(5n) { opacity: 0; }

  .articles-section { position: relative; overflow: hidden; color: var(--chalk); background: var(--ink); }
  .articles-inner { position: relative; display: grid; grid-template-columns: minmax(250px, .46fr) minmax(0, 1.2fr); gap: clamp(56px, 9vw, 140px); padding-block: clamp(100px, 12vw, 160px); }
  .articles-section header { position: relative; z-index: 2; }
  .articles-section header p { color: rgb(242 239 230 / .7); }
  .articles-section :global(.text-link--ink) { color: var(--chalk); }
  .article-list { position: relative; z-index: 2; border-top: 2px solid var(--chalk); }
  .article-list a { display: grid; grid-template-columns: 112px 1fr minmax(180px, .8fr) 24px; gap: 24px; align-items: start; padding: 28px 0; color: var(--chalk); border-bottom: 1px solid var(--rule-on-dark); text-decoration: none; }
  .article-list time { color: var(--cobalt-soft); font-size: .9rem; }
  .article-list p { margin: 3px 0 0; color: rgb(242 239 230 / .7); font-size: .96rem; }
  .article-list a > span { color: var(--cobalt-soft); transition: transform var(--motion); }
  .article-list a:hover h3 { color: var(--cobalt-soft); }
  .article-list a:hover > span { transform: translate(4px, -4px); }
  .orbit { position: absolute; right: -13vw; bottom: -28vw; width: min(52vw, 760px); aspect-ratio: 1; border: 1px solid rgb(181 194 255 / .38); border-radius: 50%; }
  .orbit::before, .orbit::after { position: absolute; inset: 16%; content: ''; border: inherit; border-radius: inherit; }
  .orbit::after { inset: 34%; }
  .orbit i { position: absolute; width: 18px; aspect-ratio: 1; border-radius: 50%; background: var(--cobalt); }
  .orbit i:nth-child(1) { left: 4%; top: 35%; }
  .orbit i:nth-child(2) { left: 28%; top: 10%; }
  .orbit i:nth-child(3) { right: 17%; top: 24%; }

  @media (prefers-reduced-motion: no-preference) {
    .hero-copy { animation: hero-copy-in .7s cubic-bezier(.16, 1, .3, 1) both; }
    .hero-artwork { animation: hero-art-in 1s cubic-bezier(.16, 1, .3, 1) both; }
    @keyframes hero-copy-in { from { opacity: .2; transform: translateY(24px); } }
    @keyframes hero-art-in { from { opacity: .7; filter: blur(9px); transform: scale(1.02); } }
  }

  @media (max-width: 980px) {
    .visual-language { grid-template-columns: 1fr; min-height: 680px; }
    .visual-copy { grid-column: 1; width: min(52%, 520px); margin-left: auto; }
    .achievements-section, .articles-inner { grid-template-columns: 1fr; gap: 58px; }
    .achievements-section header { position: static; }
    .pixel-field { display: none; }
  }

  @media (max-width: 700px) {
    .hero { min-height: 0; display: flex; flex-direction: column; }
    .hero-inner { min-height: 930px; align-items: flex-start; padding-top: 44px; padding-bottom: 500px; }
    .hero-artwork { object-position: 24% center; }
    .hero-copy { width: 100%; }
    h1 { max-width: 7ch; font-size: clamp(3.1rem, 15vw, 4.35rem); line-height: .9; }
    .hero-statement { max-width: 17ch; margin-top: 30px; font-size: 1.18rem; line-height: 1.5; }
    .hero-description { max-width: 24ch; margin-top: 18px; font-size: .98rem; line-height: 1.72; }
    .hero-actions { width: min(100%, 250px); display: grid; grid-template-columns: 1fr; gap: 10px; margin-top: 28px; }
    .hero-actions :global(.text-link), .outline-action { width: 100%; }
    .section-index > div { grid-template-columns: 1fr; }
    .section-index a { min-height: 96px; border-right: 1px solid var(--rule-on-dark); border-bottom: 1px solid var(--rule-on-dark); }
    .visual-language { grid-template-columns: 1fr; min-height: 0; margin-block: 70px; overflow: visible; background: transparent; }
    .visual-artwork { position: relative; z-index: 0; grid-row: 2; aspect-ratio: 1.3; height: auto; object-position: 36% center; }
    .visual-avatar { left: 50%; top: auto; bottom: 18px; width: clamp(162px, 46vw, 196px); padding: 8px; transform: translateX(-50%); }
    .visual-copy { grid-column: 1; grid-row: 1; width: auto; margin: 0; padding: 42px 22px 52px; background: rgb(252 251 248 / .82); box-shadow: none; }
    .signal-mark { right: -4px; top: -82px; width: 72px; }
    .register-row { grid-template-columns: 76px 1fr 24px; gap: 14px; }
    .register-row .year { grid-column: 1; grid-row: 2; }
    .row-arrow { grid-column: 3; grid-row: 1; }
    .article-list a { grid-template-columns: 1fr 24px; gap: 8px 14px; }
    .article-list time, .article-list h3, .article-list p { grid-column: 1; }
    .article-list a > span { grid-column: 2; grid-row: 1 / span 3; align-self: center; }
    .orbit { width: 100vw; opacity: .65; }
  }
</style>
