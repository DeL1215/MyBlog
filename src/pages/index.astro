---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TextLink from '../components/TextLink.astro';
import { achievementCategoryLabel, achievementTypeLabel } from '../data/achievements';

const achievements = (await getCollection('achievements', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => b.data.year - a.data.year).slice(0, 4);
const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()).slice(0, 3);
const formatDate = (date: Date) => new Intl.DateTimeFormat('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit' }).format(date);
---

<BaseLayout title="盧鼎頤｜成果與創作部落格" description="盧鼎頤的個人部落格，整理技術型與藝術型成果，記錄學習、實作與思考。">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-inner shell">
      <div class="hero-copy">
        <p class="hero-kicker">盧鼎頤｜個人部落格</p>
        <h1 id="hero-title">記錄成果與思考的個人部落格。</h1>
        <p class="hero-intro">收錄技術與藝術成果、競賽、證照，以及製作過程中的筆記。</p>
        <div class="hero-actions">
          <TextLink href="/blog/" tone="light">閱讀文章</TextLink>
          <TextLink href="/achievements/" tone="light">瀏覽成果</TextLink>
        </div>
      </div>
      <figure class="hero-art">
        <img
          src="/images/hero-modern-classical.webp"
          alt="石膏雕塑、金屬框架與青瓷綠平面構成的現代古典首頁視覺"
          width="1122"
          height="1402"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
      <nav class="hero-index" aria-label="成果領域">
        <a href="/achievements/?domain=technical"><strong>技術型</strong><span>程式、電子、製作與相關成果</span></a>
        <a href="/achievements/?domain=artistic"><strong>藝術型</strong><span>視覺、媒材、創作與相關成果</span></a>
      </nav>
    </div>
  </section>

  <section class="achievements-section shell" aria-labelledby="achievements-title">
    <header>
      <h2 id="achievements-title">成果</h2>
      <p>依領域與形式整理作品、競賽、證照和學習紀錄。</p>
      <TextLink href="/achievements/">全部成果</TextLink>
    </header>
    <div class="register">
      {achievements.map((item) => (
        <a class="register-row" data-category={item.data.category} href={`/achievements/${item.id}/`}>
          <span class="kind">{achievementCategoryLabel[item.data.category]}<small>{achievementTypeLabel[item.data.type]}</small></span>
          <div><h3>{item.data.title}</h3><p>{item.data.description}</p></div>
          <span class="year">{item.data.year}</span>
          {item.data.sample && <span class="sample">內容範例</span>}
        </a>
      ))}
      {achievements.length === 0 && <p class="empty-state">目前尚未公開成果。</p>}
    </div>
  </section>

  <section class="articles-section" aria-labelledby="articles-title">
    <div class="articles-inner shell">
      <header>
        <h2 id="articles-title">文章</h2>
        <TextLink href="/blog/">全部文章</TextLink>
      </header>
      <div class="article-list">
        {posts.map((post) => (
          <a href={`/blog/${post.id}/`}>
            <span class="sample">{post.data.sample ? '內容範例' : '文章'}</span>
            <h3>{post.data.title}</h3>
            <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
          </a>
        ))}
        {posts.length === 0 && <p class="empty-state">目前尚未公開文章。</p>}
      </div>
    </div>
  </section>

  <section class="about-section shell" aria-labelledby="about-title">
    <figure class="about-visual">
      <img
        class="about-art"
        src="/images/editorial-arches.webp"
        alt=""
        width="1536"
        height="1024"
        loading="lazy"
        aria-hidden="true"
      />
      <img class="about-portrait" src="/images/profile-placeholder.svg" alt="盧鼎頤的大頭照預留位置" />
      <figcaption>照片預留</figcaption>
    </figure>
    <div class="about-copy">
      <h2 id="about-title">網站作者</h2>
      <p><strong>盧鼎頤</strong>，畢業於大安高工資訊科，目前就讀於台灣科技大學電子工程系。</p>
      <TextLink href="/about/">關於我</TextLink>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { margin-top: -88px; padding-top: 88px; color: var(--paper); background: var(--night); }
  .hero-inner { min-height: calc(100dvh - 88px); display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(320px, .72fr); grid-template-rows: minmax(0, 1fr) auto; gap: 32px clamp(48px, 7vw, 110px); align-items: center; padding-block: clamp(36px, 5vw, 68px) 24px; }
  .hero-copy { align-self: center; }
  .hero-kicker { margin: 0 0 24px; color: var(--flame); font: 600 .72rem/1.5 var(--font-ui); letter-spacing: .08em; }
  h1 { max-width: 850px; margin: 0; color: var(--paper); font: 600 clamp(3.7rem, 6.6vw, 6.2rem)/1.02 var(--font-display); letter-spacing: -.04em; }
  .hero-copy .hero-intro { max-width: 30ch; margin: 30px 0 22px; color: var(--paper-deep); font-size: clamp(1rem, 1.35vw, 1.16rem); line-height: 1.8; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 16px 34px; }
  .hero-art { position: relative; width: min(100%, 440px); margin: 0; padding: 9px; justify-self: end; background: var(--glass); border: 1px solid var(--glass-border); border-radius: 24px; box-shadow: 0 30px 90px rgba(3, 5, 10, .24), inset 0 1px 0 rgba(255, 255, 255, .08); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); }
  .hero-art img { width: 100%; max-height: min(62vh, 610px); border-radius: 16px; object-fit: cover; object-position: center; }
  .hero-index { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1fr; padding-inline: 24px; background: var(--glass); border: 1px solid var(--glass-border); border-radius: 18px; box-shadow: inset 0 1px 0 rgba(255, 255, 255, .05); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); }
  .hero-index a { display: grid; grid-template-columns: 96px 1fr; gap: 20px; padding: 20px 0; color: var(--paper); text-decoration: none; }
  .hero-index a + a { border-left: 1px solid var(--rule-on-dark); padding-left: clamp(28px, 5vw, 72px); }
  .hero-index strong { font: 600 1.05rem var(--font-display); }
  .hero-index span { color: var(--paper-deep); font-size: .84rem; }
  .hero-index a:hover strong { color: var(--flame); }
  .achievements-section { display: grid; grid-template-columns: minmax(230px, .55fr) minmax(0, 1.45fr); gap: clamp(60px, 10vw, 150px); padding-block: clamp(100px, 13vw, 180px); }
  .achievements-section > header { align-self: start; }
  .achievements-section h2, .articles-section h2 { margin: 0; font: 600 clamp(3.5rem, 7vw, 6.2rem)/1 var(--font-display); letter-spacing: -.035em; }
  .achievements-section header p { max-width: 25ch; margin: 28px 0 22px; color: var(--muted); line-height: 1.8; }
  .register { border-top: 1px solid var(--ink); }
  .register-row { position: relative; display: grid; grid-template-columns: 115px 1fr 58px; gap: 24px; align-items: start; color: var(--ink); border-bottom: 1px solid var(--rule); padding: 30px 14px 30px 0; text-decoration: none; transition: background var(--motion); }
  .register-row:hover { background: color-mix(in srgb, var(--flame) 16%, transparent); }
  .register-row > div { transition: transform var(--motion); }
  .register-row:hover > div { transform: translateX(8px); }
  .kind, .year, .sample { color: var(--category-color, var(--blue)); font: 600 .7rem var(--font-ui); letter-spacing: .06em; }
  .kind small { display: block; margin-top: 8px; color: var(--muted); font: inherit; letter-spacing: 0; }
  .register-row[data-category='technical'] { --category-color: var(--blue); }
  .register-row[data-category='artistic'] { --category-color: var(--truffle); }
  .register-row h3, .article-list h3 { margin: 0; font: 600 clamp(1.45rem, 2.25vw, 2.15rem)/1.35 var(--font-display); transition: color var(--motion); }
  .register-row p { max-width: 650px; margin: 8px 0 0; color: var(--muted); }
  .register-row > .sample { position: absolute; right: 0; bottom: 8px; color: var(--muted); }
  .articles-section { background: var(--paper-deep); }
  .articles-inner { display: grid; grid-template-columns: minmax(230px, .55fr) minmax(0, 1.45fr); gap: clamp(60px, 10vw, 150px); padding-block: clamp(90px, 12vw, 160px); }
  .articles-section header { display: flex; min-height: 210px; flex-direction: column; justify-content: space-between; }
  .article-list { border-top: 1px solid var(--ink); }
  .article-list a { display: grid; grid-template-columns: 100px 1fr 110px; align-items: baseline; gap: 24px; color: var(--ink); border-bottom: 1px solid var(--rule); padding: 28px 0; text-decoration: none; }
  .article-list a:hover h3 { color: var(--blue); }
  .article-list time { color: var(--muted); font: 400 .72rem var(--font-ui); }
  .about-section { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(300px, .75fr); gap: clamp(64px, 9vw, 140px); align-items: center; padding-block: clamp(110px, 13vw, 180px); }
  .about-visual { position: relative; margin: 0 42px 42px 0; }
  .about-art { width: 100%; aspect-ratio: 3 / 2; border: 1px solid var(--rule); border-radius: 20px; object-fit: cover; }
  .about-portrait { position: absolute; right: -42px; bottom: -42px; width: clamp(150px, 17vw, 235px); aspect-ratio: 1; border: 10px solid rgba(238, 236, 231, .82); border-radius: 50%; background: var(--paper-deep); box-shadow: 0 24px 70px rgba(18, 20, 28, .18); object-fit: cover; backdrop-filter: blur(16px); }
  .about-visual figcaption { position: absolute; right: -34px; bottom: -64px; color: var(--muted); font: 500 .68rem var(--font-ui); letter-spacing: .06em; }
  .about-copy h2 { margin: 0; font: 600 clamp(2.8rem, 5vw, 5rem)/1.05 var(--font-display); letter-spacing: -.035em; }
  .about-copy p { max-width: 32ch; margin: 30px 0 24px; font-size: clamp(1rem, 1.35vw, 1.18rem); line-height: 1.9; }
  .about-copy strong { font-family: var(--font-display); font-weight: 600; }
  @media (prefers-reduced-motion: no-preference) { .hero-copy, .hero-art { animation: enter .75s cubic-bezier(.16, 1, .3, 1) both; } .hero-art { animation-delay: .1s; } @keyframes enter { from { transform: translateY(24px); } } }
  @media (max-width: 900px) { .hero-inner { grid-template-columns: minmax(0, 1fr) 260px; min-height: auto; } .hero-art { margin-right: 12px; } .achievements-section, .articles-inner { grid-template-columns: 1fr; gap: 54px; } .achievements-section header p { max-width: 36ch; } .about-section { grid-template-columns: 1fr; } .about-visual { width: min(88%, 720px); } .about-copy { max-width: 620px; } }
  @media (max-width: 620px) { .hero { margin-top: -80px; padding-top: 80px; } .hero-inner { grid-template-columns: 1fr; padding-top: 40px; } .hero-kicker { margin-bottom: 18px; } h1 { font-size: clamp(3.3rem, 15vw, 5rem); } .hero-copy .hero-intro { margin-top: 24px; } .hero-art { width: min(86%, 350px); margin-top: 6px; justify-self: end; } .hero-art img { max-height: none; } .hero-index { grid-template-columns: 1fr; padding-inline: 18px; } .hero-index a + a { border-left: 0; border-top: 1px solid var(--rule-on-dark); padding-left: 0; } .register-row { grid-template-columns: 82px 1fr; gap: 16px; } .register-row .year { grid-column: 1; grid-row: 2; } .article-list a { grid-template-columns: 80px 1fr; gap: 16px; } .article-list time { grid-column: 2; } .about-section { padding-bottom: 130px; } .about-visual { width: calc(100% - 24px); margin-right: 24px; } .about-portrait { right: -24px; bottom: -64px; border-width: 7px; } .about-visual figcaption { right: -18px; bottom: -84px; } }
</style>
